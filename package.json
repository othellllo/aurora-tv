{
  "name": "aurora-tv",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "description": "Aurora TV — 苹果 TV 风格的跨端 TVBox 客户端（Android / Windows / Android TV）",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4173",
    "proxy": "node server/proxy.mjs",
    "sync": "node server/sync.mjs",
    "share": "node scripts/share.mjs",
    "start": "node scripts/dev.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "hls.js": "^1.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "terser": "^5.37.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  }
}
